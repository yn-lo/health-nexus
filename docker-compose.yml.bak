# Health Nexus 全栈 Docker 部署
# 一键启动: docker compose up -d

name: health-nexus

services:
  postgres:
    image: pgvector/pgvector:pg16
    container_name: hn-postgres
    environment:
      POSTGRES_USER: health
      POSTGRES_PASSWORD: health
      POSTGRES_DB: health_nexus
      TZ: Asia/Shanghai
    ports:
      - "5432:5432"
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U health -d health_nexus"]
      interval: 10s
      timeout: 3s
      retries: 5
      start_period: 10s
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    container_name: hn-redis
    command: >
      redis-server
      --appendonly yes
      --maxmemory 256mb
      --maxmemory-policy allkeys-lru
    ports:
      - "6379:6379"
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 3s
      retries: 5
    restart: unless-stopped

  server:
    build: .
    container_name: hn-server
    command: ["/bin/server"]
    ports:
      - "8080:8080"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      HEALTH_NEXUS_POSTGRES_DSN: "postgres://health:health@postgres:5432/health_nexus?sslmode=disable"
      HEALTH_NEXUS_REDIS_ADDR: "redis:6379"
    restart: unless-stopped

  worker:
    build: .
    container_name: hn-worker
    command: ["/bin/worker"]
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      server:
        condition: service_started
    environment:
      HEALTH_NEXUS_POSTGRES_DSN: "postgres://health:health@postgres:5432/health_nexus?sslmode=disable"
      HEALTH_NEXUS_REDIS_ADDR: "redis:6379"
    restart: unless-stopped

volumes:
  pgdata:
  redisdata:
