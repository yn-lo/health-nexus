{
  "name": "health-nexus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --quiet",
    "lint:style": "node scripts/style-guard.mjs",
    "lint:fix": "eslint src/ --quiet --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json && vue-tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run tests/arch/",
    "dup-check": "jscpd src/",
    "dead-code": "knip"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/vue": "^1.23.0",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-text-align": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "@tiptap/vue-3": "3.31.3",
    "markdown-it": "^15.0.2",
    "ofetch": "latest",
    "pinia": "^2",
    "vue": "^3.5.44",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4",
    "@vitejs/plugin-vue": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "happy-dom": "^20.10.6",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "tailwindcss": "^4",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "vite": "^6",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "latest",
    "vue-tsc": "latest"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "smol-toml": "^1.7.1",
    "postcss-selector-parser": "^7.1.6"
  }
}
