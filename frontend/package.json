{
  "name": "health-nexus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ --quiet",
    "lint:style": "node scripts/style-guard.mjs",
    "lint:fix": "eslint src/ --quiet --fix",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:arch": "vitest run tests/arch/",
    "dup-check": "jscpd src/",
    "dead-code": "knip"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@lucide/vue": "^1.23.0",
    "@tiptap/starter-kit": "latest",
    "@tiptap/vue-3": "latest",
    "markdown-it": "latest",
    "ofetch": "latest",
    "pinia": "^2",
    "vant": "^4",
    "vue": "^3.5",
    "vue-router": "^4"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4",
    "@types/markdown-it": "latest",
    "@vant/auto-import-resolver": "latest",
    "@vitejs/plugin-vue": "latest",
    "eslint": "latest",
    "eslint-plugin-vue": "latest",
    "happy-dom": "^20.10.6",
    "jscpd": "^4.0.5",
    "knip": "^5",
    "tailwindcss": "^4",
    "typescript": "latest",
    "typescript-eslint": "latest",
    "unplugin-vue-components": "latest",
    "vite": "^6",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "latest",
    "vue-tsc": "latest"
  }
}
