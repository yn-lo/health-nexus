# ============================================
# Health Nexus - 生产环境配置模板
# ============================================
# 使用方式:
#   1. 复制此文件为 .env: cp .env.production .env
#   2. 修改所有标记为 CHANGE-ME 的配置
#   3. 运行: docker-compose -f docker-compose.yml up -d
# ============================================

# ============================================
# Docker 特有配置
# ============================================

# Web服务端口映射（宿主机端口:容器端口）
# 生产环境建议不使用默认端口
WEB_PORT=5230

# ============================================
# Django 核心配置（生产环境必须修改）
# ============================================

# 调试模式（生产环境必须为False）
DEBUG=False

# Django 密钥（必须修改为强随机密钥）
# 生成命令: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=CHANGE-ME-TO-A-STRONG-RANDOM-SECRET-KEY-AT-LEAST-50-CHARS

# 允许访问的主机名（改为实际域名）
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# CSRF 可信来源（使用HTTPS协议）
CSRF_TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Cookie安全设置（生产环境必须为True）
SESSION_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

CSRF_COOKIE_SECURE=True
CSRF_COOKIE_HTTPONLY=True
CSRF_COOKIE_SAMESITE=Lax

# SSL重定向（使用HTTPS时必须为True）
SECURE_SSL_REDIRECT=True

# HSTS 配置（启用HTTPS后设置为31536000，即1年）
SECURE_HSTS_SECONDS=31536000

# 字段加密密钥
# 生成命令: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FIELD_ENCRYPTION_KEY=CHANGE-ME-TO-A-32-BYTE-FERNET-ENCRYPTION-KEY-HERE

# ============================================
# 超级用户配置（首次部署自动创建）
# ============================================

SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@your-domain.com
SUPERUSER_PASSWORD=CHANGE-ME-TO-VERY-STRONG-PASSWORD

# ============================================
# 数据库配置（生产环境必须修改密码）
# ============================================

DB_NAME=health_nexus
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-TO-STRONG-DATABASE-PASSWORD
DB_HOST=db
DB_PORT=5432

# ============================================
# Redis 配置
# ============================================

# Redis 密码（生产环境必须修改）
REDIS_PASSWORD=CHANGE-ME-TO-STRONG-REDIS-PASSWORD

# 注意：.env 文件不支持 ${VAR} 插值，密码需直接写入 URL
Q_REDIS=redis://:CHANGE-ME-TO-STRONG-REDIS-PASSWORD@redis:6379/0
CACHE_REDIS=redis://:CHANGE-ME-TO-STRONG-REDIS-PASSWORD@redis:6379/1

# ============================================
# AI 服务配置
# ============================================
# AI 配置已迁移到数据库管理。
# 通过 Django Admin > 系统配置 > AI 提供商配置 管理。
# 无需在此处配置任何 AI_* 环境变量。

# ============================================
# 向量化与 RAG 参数配置
# ============================================

VECTOR_DIMENSIONS=1024
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.35
SENSITIVE_WORDS=自杀,自残,不想活,跳楼,割腕

# ============================================
# 静态文件和媒体文件配置
# ============================================

STATIC_URL=/static/
MEDIA_URL=/media/

# ============================================
# 日志配置
# ============================================

LOG_LEVEL=WARNING

# ============================================
# 测试数据配置（生产环境必须为false）
# ============================================

CREATE_TEST_DATA=false
