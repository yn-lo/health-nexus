# Health Nexus 容器运行密钥（勿提交，已被 .gitignore 忽略）
# 本文件是所有容器凭据的唯一来源；docker-compose.yml 通过 ${VAR} 引用。
# 注意 ENCRYPTION_KEY 必须与写库时的加密密钥一致（当前为开发占位值，
# 生产环境务必覆盖并收敛到同一把）。

POSTGRES_USER=health
POSTGRES_DB=health_nexus
POSTGRES_PASSWORD=4b605c71292e231391b2a40d63d9fe5b
REDIS_PASSWORD=4d58f1021dfc47f2f701a5be6f249a91
JWT_SECRET=dev-jwt-secret-change-in-production
ENCRYPTION_KEY=dev-encryption-key-change-in-production

# 运行环境：development 加载测试数据（seed.dev.sql，账号密码统一 password123）；
# 生产必须改为 production，数据库保持干净。
HEALTH_NEXUS_ENV=development

# 初始超管密码（明文，启动时后端用 argon2id 现算哈希写库；留空则不创建 admin 账号）。
# 开发默认 Pass1234；生产请用环境变量注入一次性强密码，并登录后立即更换。
HEALTH_NEXUS_SEED_ADMIN_PASSWORD=Pass1234