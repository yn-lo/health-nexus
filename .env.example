# ============================================
# Health Nexus - Go 后端环境变量模板
# ============================================
# 后端用 viper 加载，环境变量前缀 HEALTH_NEXUS_，层级用 _ 分隔（. → _）。
# 例如 server.port 对应 HEALTH_NEXUS_SERVER_PORT。
# 使用方式: cp .env.example .env，按需修改后 export $(cat .env | xargs)
# 标记 [生产必改] 的项在生产环境必须修改。
# ============================================

# ============================================
# HTTP 服务器
# ============================================
HEALTH_NEXUS_SERVER_PORT=8080
HEALTH_NEXUS_SERVER_READ_TIMEOUT=15s
HEALTH_NEXUS_SERVER_SHUTDOWN_TIMEOUT=10s

# ============================================
# PostgreSQL（含 pgvector 扩展）
# ============================================
# [生产必改] DSN 含密码，生产环境必须替换
HEALTH_NEXUS_POSTGRES_DSN=postgres://health:health@localhost:5432/health_nexus?sslmode=disable
HEALTH_NEXUS_POSTGRES_MAX_CONNS=25
HEALTH_NEXUS_POSTGRES_MIN_CONNS=5
HEALTH_NEXUS_POSTGRES_MAX_CONN_LIFETIME=1h

# ============================================
# Redis（限流 + 会话锁 + refresh token 占用）
# ============================================
# [生产必改] 生产环境必须设密码
HEALTH_NEXUS_REDIS_ADDR=localhost:6379
HEALTH_NEXUS_REDIS_PASSWORD=
HEALTH_NEXUS_REDIS_DB=0

# ============================================
# JWT（HS256 对称签名）
# ============================================
# [生产必改] JWT 签名密钥，生产环境必须替换为高熵随机字符串
HEALTH_NEXUS_JWT_SECRET=dev-jwt-secret-change-in-production
HEALTH_NEXUS_JWT_ACCESS_TTL=30m
HEALTH_NEXUS_JWT_REFRESH_TTL=168h
HEALTH_NEXUS_JWT_ISSUER=health-nexus

# ============================================
# LLM 服务（OpenAI 兼容 API）
# ============================================
# [生产必改] 必须配置真实 API Key，否则启动失败
HEALTH_NEXUS_LLM_BASE_URL=https://api.openai.com/v1
HEALTH_NEXUS_LLM_API_KEY=
HEALTH_NEXUS_LLM_CHAT_MODEL=gpt-4o
HEALTH_NEXUS_LLM_REWRITE_MODEL=gpt-4o-mini
HEALTH_NEXUS_LLM_EMBEDDING_MODEL=text-embedding-3-small
HEALTH_NEXUS_LLM_TIMEOUT=60s

# 分离的 provider 配置（可选，零值字段回退到主 LLM 配置）
# embedding provider（如硅基流动 BAAI/bge-m3）——主 provider 不支持 embedding 时必须配置
HEALTH_NEXUS_LLM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
HEALTH_NEXUS_LLM_EMBEDDING_API_KEY=
HEALTH_NEXUS_LLM_EMBEDDING_MODEL=BAAI/bge-m3
# rerank provider（硅基流动 BAAI/bge-reranker-v2-m3，独立 /v1/rerank endpoint）
HEALTH_NEXUS_LLM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
HEALTH_NEXUS_LLM_RERANK_API_KEY=
HEALTH_NEXUS_LLM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# rewrite provider（智谱 glm-4.7-flash 小模型，用于查询改写）
HEALTH_NEXUS_LLM_REWRITE_BASE_URL=https://open.bigmodel.cn/api/paas/v4
HEALTH_NEXUS_LLM_REWRITE_API_KEY=
HEALTH_NEXUS_LLM_REWRITE_MODEL=glm-4.7-flash

# ============================================
# CORS 跨域
# ============================================
# 多个源用逗号分隔
HEALTH_NEXUS_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ============================================
# Argon2id 密码哈希参数（OWASP 2023 推荐）
# ============================================
HEALTH_NEXUS_ARGON2_MEMORY=65536
HEALTH_NEXUS_ARGON2_ITERATIONS=3
HEALTH_NEXUS_ARGON2_PARALLELISM=2
HEALTH_NEXUS_ARGON2_SALT_LENGTH=16
HEALTH_NEXUS_ARGON2_KEY_LENGTH=32

# ============================================
# 安全配置
# ============================================
# [生产必改] AES-GCM 加密密钥派生 passphrase，用于加密 DB 中的 AI Provider API Key
# 生产环境必须替换为高熵随机字符串
HEALTH_NEXUS_SECURITY_ENCRYPTION_KEY=dev-encryption-key-change-in-production
