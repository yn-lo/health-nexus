# Health Nexus 容器运行密钥模板（复制为 .env 后填写真实值；.env 已被 .gitignore 忽略）。
# 本文件是所有容器凭据的唯一来源；docker-compose.yml 通过 ${VAR} 引用。
# 注意 ENCRYPTION_KEY 必须与写库时的加密密钥一致；生产环境务必覆盖并收敛到同一把。
# 下列值为占位符，请全部替换为强随机值，切勿直接用于生产。

POSTGRES_USER=health
POSTGRES_DB=health_nexus
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-encryption-key

# 运行环境：development 加载测试数据（seed.dev.sql，账号密码统一 password123）；
# 生产必须改为 production，数据库保持干净。
HEALTH_NEXUS_ENV=development

# 问答默认责任科室 id（公共科室）。匿名用户与未指定科室的会话落到此科室，
# 保证"统一理解与审查"有科室语境；0/留空则运行时取第一个公共启用科室。
CHAT_DEFAULT_DEPT_ID=5

# 初始超管密码（明文，启动时后端用 argon2id 现算哈希写库；留空则不创建 admin 账号）。
# 生产请用环境变量注入一次性强密码，并登录后立即更换。
HEALTH_NEXUS_SEED_ADMIN_PASSWORD=change-me-admin-password
